# Production Environment Variables Template for Railway
# Copy this file and replace all placeholder values

# ===== REQUIRED SECURITY VARIABLES =====
# These MUST be set in production or the app will not start

# API Key for authentication (minimum 32 characters)
# Generate with: openssl rand -hex 32
MVP_API_KEY=your-secure-api-key-at-least-32-characters-long

# Session Secret for JWT/session encryption (minimum 64 characters)
# Generate with: openssl rand -hex 64
SESSION_SECRET=your-super-secure-session-secret-at-least-64-characters-long

# Database Encryption Key for FERPA-compliant data encryption (minimum 32 characters)
# Generate with: openssl rand -hex 32
# CRITICAL: This encrypts all student PII in the database
DATABASE_ENCRYPTION_KEY=your-secure-database-encryption-key-32-chars

# ===== REQUIRED ENVIRONMENT SETTINGS =====
# These control production behavior

# Environment mode (MUST be "production" for Railway)
ENVIRONMENT=production

# Development mode (MUST be "false" in production)
DEVELOPMENT_MODE=false

# Enable web login in production (REQUIRED for admin access)
DEMO_LOGIN_ENABLED=true

# ===== DATABASE (AUTO-PROVIDED BY RAILWAY) =====
# Railway automatically provides this when you add PostgreSQL
# DATABASE_URL=postgresql://user:pass@host/database

# ===== OPTIONAL CONFIGURATION =====
# These have sensible defaults but can be customized

# Logging
LOG_LEVEL=INFO
SQL_DEBUG=false

# Rate Limiting (requests per time period)
API_RATE_LIMIT=30        # per minute
UPLOAD_RATE_LIMIT=10     # per hour
AUTH_RATE_LIMIT=5        # per hour

# File Upload Limits
MAX_FILE_SIZE_MB=10

# ===== OPTIONAL INTEGRATIONS =====
# Only add these if you want to enable specific features

# OpenAI GPT Integration (for AI insights)
# OPENAI_API_KEY=sk-your-openai-api-key
# GPT_MODEL=gpt-4o-mini
# GPT_TIMEOUT=30
# GPT_CACHE_ENABLED=true

# Email Notifications (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ===== DEPLOYMENT SETTINGS =====
# Railway-specific settings (usually auto-configured)

# Port is auto-provided by Railway
# PORT=8000

# Worker settings
# WEB_CONCURRENCY=2
# WORKERS=4