{
  "name": "student-success-platform",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "bun --cwd apps/web dev",
    "build": "bun --cwd apps/web build",
    "start": "bun --cwd apps/web run start",
    "lint": "eslint \"apps/web/**/*.{js,jsx,ts,tsx}\" --ignore-pattern \"apps/web/.next/**\"",
    "format": "eslint \"apps/web/**/*.{js,jsx,ts,tsx}\" --ignore-pattern \"apps/web/.next/**\" --fix",
    "db:generate": "bun --cwd apps/web db:generate",
    "db:migrate": "bun --cwd apps/web db:migrate",
    "db:studio": "bun --cwd apps/web db:studio",
    "db:baseline": "bun --cwd apps/web db:baseline"
  },
  "devDependencies": {
    "eslint-config-next": "^16.1.1"
  }
}
