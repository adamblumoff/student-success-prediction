# ML service environment
ML_SERVICE_API_KEY=your-ml-service-api-key
ML_REQUIRE_API_KEY=true
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=20000
RATE_LIMIT_PER_MIN=60
K12_MODEL_FLAVOR=default
K12_MODELS_DIR=./results/models/k12

# Optional training pipeline overrides (used by start.sh)
DATA_DIR=./data
MODEL_OUT_DIR=./results/models/k12
SYNTH_ROWS=5000
MIX_ROWS=10000
SYNTH_SUCCESS_RATE=0.5
SYNTH_LABEL_NOISE=0.08
SYNTH_FEATURE_NOISE=0.03
MIX_FEATURE_NOISE=0.03
MIX_DROPOUT_RATE=0.05
SYNTH_FRAC=0.5
OULAD_FRAC=0.3
UCI_FRAC=0.2
